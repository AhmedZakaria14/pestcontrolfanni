rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidWarranty(data) {
      return data.keys().hasAll(['code', 'customerName', 'serviceType', 'propertyAddress', 'issueDate', 'expiryDate', 'status']) &&
        data.keys().hasOnly(['code', 'customerName', 'serviceType', 'propertyAddress', 'issueDate', 'expiryDate', 'status', 'technicianName', 'notes', 'createdAt']) &&
        data.code is string && data.code.size() >= 5 && data.code.size() <= 50 && data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        data.serviceType is string && data.serviceType.size() >= 2 && data.serviceType.size() <= 100 &&
        data.propertyAddress is string && data.propertyAddress.size() >= 5 && data.propertyAddress.size() <= 200 &&
        data.issueDate is string && data.issueDate.size() <= 50 &&
        data.expiryDate is string && data.expiryDate.size() <= 50 &&
        data.status is string && data.status in ['active', 'expired', 'pending'] &&
        (!('technicianName' in data) || (data.technicianName is string && data.technicianName.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('createdAt' in data) || data.createdAt is string);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /warranties/{warrantyId} {
      allow get: if isValidId(warrantyId);
      allow list: if true;
      allow create: if isValidId(warrantyId) && isValidWarranty(incoming());
      allow update: if isValidId(warrantyId) && isValidWarranty(incoming()) && incoming().code == existing().code;
      allow delete: if isValidId(warrantyId);
    }
  }
}
