{
  "entities": {
    "WarrantyCertificate": {
      "title": "Warranty Certificate",
      "description": "Electronic warranty certificate for pest control services",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 50
        },
        "serviceType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "propertyAddress": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "issueDate": {
          "type": "string",
          "maxLength": 50
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 50
        },
        "durationYears": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "pending"
          ]
        },
        "technicianName": {
          "type": "string",
          "maxLength": 120
        },
        "pesticideDetails": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "customerName",
        "serviceType",
        "propertyAddress",
        "issueDate",
        "expiryDate",
        "status"
      ]
    },
    "BookingRequest": {
      "title": "Booking Request",
      "description": "Customer inspection and pest control booking request",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "service": {
          "type": "string",
          "maxLength": 150
        },
        "area": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "contacted",
            "scheduled",
            "completed",
            "cancelled"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "phone",
        "service",
        "status"
      ]
    }
  },
  "firestore": {
    "/warranties/{warrantyId}": {
      "schema": "WarrantyCertificate",
      "description": "Stores warranty certificates verifiable by warranty code and manageable by admin"
    },
    "/bookings/{bookingId}": {
      "schema": "BookingRequest",
      "description": "Stores incoming customer inspection booking requests submitted via website forms"
    }
  }
}
