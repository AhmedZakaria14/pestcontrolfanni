{
  "entities": {
    "WarrantyCertificate": {
      "title": "Warranty Certificate",
      "description": "Electronic warranty certificate for pest control services",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 5,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "serviceType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "propertyAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "issueDate": {
          "type": "string",
          "maxLength": 50
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "pending"
          ]
        },
        "technicianName": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "customerName",
        "serviceType",
        "propertyAddress",
        "issueDate",
        "expiryDate",
        "status"
      ]
    }
  },
  "firestore": {
    "/warranties/{warrantyId}": {
      "schema": "WarrantyCertificate",
      "description": "Stores warranty certificates verifiable by warranty code"
    }
  }
}
